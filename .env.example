# ==============================================================================
# NyayaMitra — Environment Configuration Template (.env.example)
# Copy to .env for local development. NEVER COMMIT .env TO SOURCE CONTROL.
# ==============================================================================

# Application & Runtime
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
SECRET_KEY=generate-a-secure-random-32-byte-hex-string-for-production

# Security & CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=60
ENABLE_PII_REDACTION=true

# Database & Vector Storage
# For PostgreSQL with pgvector (recommended for production):
DATABASE_URL=postgresql+asyncpg://nyayamitra:password@localhost:5432/nyayamitra
# Local lightweight SQLite fallback (for quick local development/testing):
SQLITE_DB_PATH=./nyayamitra.db
USE_SQLITE_FALLBACK=true

# Cache & Rate Limiter (Redis)
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# AI / LLM Routing
# Supported: "mock" (default for offline testing), "openai", "gemini", "anthropic", "ollama"
LLM_PROVIDER=mock
PRIMARY_MODEL=gemini-2.0-flash
FALLBACK_MODEL=gpt-4o-mini
FAST_MODEL=gemini-2.0-flash-lite

# API Keys (leave blank when using LLM_PROVIDER=mock)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Embeddings & Vector Search
# Supported: "mock", "openai", "fastembed", "huggingface"
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Document Storage & OCR
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
FILE_RETENTION_HOURS=24
# Supported OCR providers: "mock", "tesseract", "google_vision"
OCR_PROVIDER=mock

# External Legal Source Adapters
INDIA_CODE_BASE_URL=https://www.indiacode.nic.in
ECOURTS_PORTAL_URL=https://services.ecourts.gov.in
NALSA_PORTAL_URL=https://nalsa.gov.in
TELE_LAW_URL=https://www.tele-law.in

# Frontend Public Variables
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=NyayaMitra
NEXT_PUBLIC_APP_VERSION=1.0.0
